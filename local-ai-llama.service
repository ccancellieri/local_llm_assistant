[Unit]
Description=Peppe LLM locale - llama.cpp Liquid LFM2.5 1.2B
After=network.target
ConditionPathExists=%h/.local/share/local-ai/models/LFM2.5-1.2B-Instruct-QAD-Q4_0.gguf

[Service]
Type=simple
WorkingDirectory=%h/.local/share/local-ai
Environment=LD_LIBRARY_PATH=%h/.local/share/local-ai/llama
ExecStart=%h/.local/share/local-ai/llama/llama-server --model %h/.local/share/local-ai/models/LFM2.5-1.2B-Instruct-QAD-Q4_0.gguf --alias peppe-local --host 127.0.0.1 --port 8080 --ctx-size 4096 --threads 4 --threads-batch 4 --batch-size 512 --ubatch-size 256 --parallel 1 --jinja --no-warmup --metrics
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=15
Nice=5
LimitNOFILE=65535
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
