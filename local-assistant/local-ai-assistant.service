[Unit]
Description=Assistente AI locale (voce, strumenti e interfaccia web)
After=omniroute.service pipewire.service network-online.target
Wants=omniroute.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/local-ai/assistant/assistant.py
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/local-ai/omniroute.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/local-ai

[Install]
WantedBy=default.target
